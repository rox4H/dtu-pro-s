include LICENSE NOTICE README.md CHANGELOG.md AGENTS.md CLAUDE.md CONTRIBUTING.md SECURITY.md
include .env.example Dockerfile
recursive-include docs *.md
recursive-include packages/npm-client *.js *.ts *.json *.md LICENSE
recursive-include tests *.py
prune packages/npm-client/node_modules
global-exclude __pycache__ *.py[cod]
