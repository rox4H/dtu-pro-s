# Hoymiles DTU
# Replace this documentation-only address with the IP address of your DTU.
DTU_IP=192.0.2.10
DTU_PORT=502
DTU_SLAVE_ID=1
HOY_MILES_TYPE=HM

# Polling
MODBUS_TIMEOUT=3
MODBUS_RETRIES=2
POLL_INTERVAL=8
MAX_MICROINVERTERS=100
LIMIT_REGISTER_ADDRESS=257
TODAY_WH_MODE=max

# Optional CHINT meter: ddsu666 (single phase) or dtsu666 (three phase)
ACCESSORIES=
# DDSU666_SLAVE_ID=
# DTSU666_SLAVE_ID=
# CHINT_SLAVE_ID=       # shared fallback
# METER_SLAVE_ID=       # legacy alias for CHINT_SLAVE_ID
# METER_PROBE=          # 1 = force search, 0 = disable search
CHINT_CANDIDATES=2,3,4,11,22,101
METER_WORD_ORDER=low
METER_RETRY_SECONDS=60
METER_PROBE_RETRY_SECONDS=300

# Local read-only HTTP API
# Paste the token issued by your company backend. Empty = authentication disabled.
API_TOKEN=
HTTP_HOST=127.0.0.1
HTTP_PORT=5001

# Logs
LOG_DIR=logs
